{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": []
  },
  "include": ["src/core/**/*.ts", "hooks/**/*.ts", "types/claude-code.d.ts"]
}
